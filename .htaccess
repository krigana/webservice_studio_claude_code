RewriteEngine On

# Закрываем служебные и приватные каталоги от прямого доступа
RewriteRule ^(config|includes|storage)(/|$) - [F,L]

# .env, .sql, .md, .log никогда не отдаём напрямую
<FilesMatch "\.(env|sql|log|md)$">
    Require all denied
</FilesMatch>

# Не индексировать содержимое каталогов
Options -Indexes

# Базовые заголовки безопасности
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Все запросы, которые не являются реальными файлами/папками — во front controller
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
