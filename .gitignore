# Окружение и секреты
.env
.env.*
config/local.php
config/*.local.php

# Загруженные пользователем файлы (изображения блога/портфолио) —
# серверные данные, не версионируются вместе с кодом.
# Сами подпапки blog/portfolio НЕ игнорируются (иначе git не даст
# исключить .gitkeep внутри них) — игнорируется только их содержимое.
/assets/uploads/*
!/assets/uploads/.gitkeep
!/assets/uploads/.htaccess
!/assets/uploads/blog
!/assets/uploads/portfolio

/assets/uploads/blog/*
!/assets/uploads/blog/.gitkeep

/assets/uploads/portfolio/*
!/assets/uploads/portfolio/.gitkeep

# Зависимости
/vendor/
/node_modules/

# Логи и кэш
*.log
/cache/
/tmp/

# ОС / редакторы
.DS_Store
Thumbs.db
.idea/
.vscode/