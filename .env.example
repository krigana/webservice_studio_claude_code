# Скопируйте этот файл в .env и заполните реальными значениями.
# .env НЕ коммитится в репозиторий (см. .gitignore).

APP_ENV=production
APP_DEBUG=false
APP_URL=https://web-service.studio

# База данных
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4

# Telegram-бот (уведомления с формы связи)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google reCAPTCHA v2 (захист форми "Контакти" від спам-ботів).
# Отримати ключі: https://www.google.com/recaptcha/admin (тип — "reCAPTCHA v2" -> "Прапорець «Я не робот»"),
# домен: web-service.studio. Якщо залишити порожнім — форма працює без капчі (як зараз).
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Админ-панель
ADMIN_SESSION_NAME=wsstudio_admin
