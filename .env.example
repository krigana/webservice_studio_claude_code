# Скопируйте этот файл в .env и заполните реальными значениями.
# .env НЕ коммитится в репозиторий (см. .gitignore).

APP_ENV=production
APP_DEBUG=false
APP_URL=https://web-service.studio

# База данных
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4

# Telegram-бот (уведомления с формы связи)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Админ-панель
ADMIN_SESSION_NAME=wsstudio_admin
